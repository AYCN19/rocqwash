#!/usr/bin/env bash
# cli/rocqwash — rocqwash unified CLI entry (bash)
#
# Subcommands: scan | names | wash | verify | seam | certify | watch
#
# Routing contract:
#   1. The generic per-file entry (the only non-underscore-prefixed .py in a
#      module directory) is auto-routed; arguments and exit codes pass
#      through 1:1 (fail-loud, never rewritten).
#   2. Underscore-prefixed .py files (e.g. wash/_abl1_wash.py) are
#      effort-specific tooling: hardcoded paths, no per-file argv —
#      the unified entry never runs them on the caller's behalf (this
#      prevents accidental writes to external sandboxes); invoke them with
#      python3 directly.
#   3. A module with no generic entry exits 3 (NOT-IMPLEMENTED; fail-loud,
#      nothing is simulated).
#   4. Several generic entries exit 4 (entry not unique; a listing is
#      printed for manual disambiguation).
#
# Exit codes:
#   0 = pass   2 = assertion failure / unknown subcommand (incl. unknown
#   certify/verify sub-verbs)   3 = no generic per-file entry   4 = generic
#   entry not unique (bare certify/verify follow the same convention)
#   9 = file missing   others = each sub-tool's own convention, passed
#   through (e.g. scan --selftest vector failure exits 2)
#
# 中文原版留档 Chinese original archive: cli/rocqwash.zh.md (bilingual
# transition archive; tool names, flags and exit-code semantics identical).
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCAN_PY="$ROOT/scan/mac_stmt_scan.py"
NAMES_PY="$ROOT/names/mac_stmt_names.py"

usage() {
  cat <<'EOF'
rocqwash — Coq/Rocq Constructive Proof Unblocking Engine (unified CLI entry)
（中文过渡注 zh transition note: this help is English-first; the original Chinese wording is archived in cli/rocqwash.zh.md）

Usage: rocqwash <subcommand> [args...]

Subcommands:
  scan     statement-surface bare-Prop-form scanner         -> scan/mac_stmt_scan.py
           (--file/--json/--manifest/--hits-csv/--baseline/--selftest)
  names    ordered top-level statement-name list + N=N ordered-equality assertion -> names/mac_stmt_names.py
           (<file>/--compare/--expect/--kinds/--include-let/--json/--names-out)
  wash     canonical wash engine + world-base hook (two generic entries; exit 4 — name one explicitly)
           -> wash/wash_engine.py | wash/world_hook.py
  verify   green-verdict four-pack + gate6 census thin wrapper -> verify/  explicit routing (verify gate4|verify_vo|verify_gate6|retrofit ...)
  seam     generation-seam probe (W13 four-mechanism)       -> seam/seam_probe.py
  certify  two-tier freeze + push-window four criteria + UNION v2 + frozen-eight list check -> certify/  explicit routing (certify freeze|push_gate|frozen8 ...)
  watch    CI monitoring + pin-IP push + ls-remote confirmation -> watch/watch.py (ci/push/confirm)
  help     this help

Routing notes:
  - The only non-"_"-prefixed .py in a module directory = the generic per-file entry, auto-routed (arguments/exit codes pass through).
  - certify's three generic pieces (freeze_manifest + push_gate + frozen8) and verify's four generic pieces (gate4 +
    verify_vo + verify_gate6 + retrofit) use explicit sub-verb routing: `rocqwash certify freeze|push_gate|frozen8 [args...]`,
    `rocqwash verify gate4|verify_vo|verify_gate6|retrofit [args...]` pass through 1:1; no sub-verb = entry
    not unique -> exit 4 with a listing for manual disambiguation; unknown sub-verb -> exit 2.
  - "_"-prefixed .py = effort-specific tooling (hardcoded paths, no per-file interface); the unified entry never runs it;
    when needed, invoke it directly, e.g. `python3 wash/_abl1_wash.py`.
  - No generic entry -> exit 3; several generic entries -> exit 4 (listing for manual disambiguation).

Exit codes: 0=pass  2=assertion-fail/unknown-subcommand  3=no-generic-entry  4=ambiguous-entry  9=file-missing
EOF
}

not_implemented() {  # $1=subcommand  $2=dir
  echo "rocqwash $1: NOT-IMPLEMENTED — the $2/ directory is empty; the module has not landed yet." >&2
  echo "  This subcommand is a reserved slot in the unified entry; it auto-enables once a module lands in $2/." >&2
  echo "  (subcommand reserved; auto-enabled once the module lands — nothing is simulated here)" >&2
  exit 3
}

run_module() {  # $1=subcommand  $2=dir  rest = passthrough args
  local sub="$1" dir="$2"; shift 2
  local entry="" n=0 c=0 f base
  # Generic entry = non-underscore-prefixed .py; _ prefix = effort-specific tooling (never run by the unified entry)
  for f in "$dir"/*.py; do
    [ -e "$f" ] || continue
    c=$((c+1))
    base="$(basename "$f")"
    case "$base" in _*) continue ;; esac
    n=$((n+1)); entry="$f"
  done
  if [ "$n" -eq 1 ]; then
    exec python3 "$entry" "$@"
  elif [ "$n" -eq 0 ]; then
    if [ "$c" -gt 0 ]; then
      echo "rocqwash $sub: $dir/ holds only campaign/seat-specific tooling (_-prefixed, $c file(s), hardcoded paths / no per-file interface); the unified entry does not run them:" >&2
      ls -A "$dir" >&2
      echo "  (auto-enables once a generic per-file entry lands — campaign tools must be invoked directly)" >&2
      exit 3
    fi
    not_implemented "$sub" "$dir"
  else
    echo "rocqwash $sub: $dir/ holds $n generic entries (entry not unique); name one explicitly (ambiguous entry):" >&2
    for f in "$dir"/*.py; do
      [ -e "$f" ] || continue
      base="$(basename "$f")"
      case "$base" in
        _*) echo "  [campaign-tool · not auto-routed] $base" >&2 ;;
        *)  echo "  [generic] $base" >&2 ;;
      esac
    done
    exit 4
  fi
}

certify_usage() {  # certify explicit-dispatch sub-help
  cat <<'EOF'
rocqwash certify — two-tier freeze + push-window four criteria + UNION v2 + frozen-eight list machine-check (explicit routing)

Usage: rocqwash certify <sub-verb> [args...]

Sub-verbs:
  freeze     two-tier freeze-list machine-check (tier1 per-file md5 + tier2 list md5)  -> certify/freeze_manifest.py
             (<dir> freeze|check --out/--tier2/--manifest/--json/--selftest)
  push_gate  push-window four criteria + UNION v2 multi-world list                     -> certify/push_gate.py
             (window|union-freeze|union-check ... / --selftest)
  frozen8    frozen-eight in-service component list machine-check (--selftest/--check/--list) -> certify/frozen8.py
             (check --list certify/frozen8_manifest.json --tier2 certify/frozen8_tier2.md5 / --selftest)

Routing notes:
  - Arguments and exit codes after the sub-verb pass through 1:1 (fail-loud, never rewritten).
  - No sub-verb = the three generic entries are not unique -> exit 4 with a listing for manual disambiguation (same contract shape as verify/).
  - Unknown sub-verb -> exit 2 (legal sub-verbs listed).

Exit codes: 0=pass  2=unknown-sub-verb  4=ambiguous-entry  others = each sub-tool's own convention, passed through
EOF
}

verify_usage() {  # verify explicit-dispatch sub-help (same contract shape as certify_usage)
  cat <<'EOF'
rocqwash verify — green-verdict four-pack (explicit routing)

Usage: rocqwash verify <sub-verb> [args...]

Sub-verbs:
  gate4      header five-field machine-check guard v2.1 (comment-hygiene three-domain scan) -> verify/gate4_comment_guard.py
             (--file/--tree/--tree-recursive/--baseline/--json/--emit-ledger; no --selftest; single-file/tree scan)
  verify_vo  generic per-file green-verdict four-pack (exit/log/magic/freshness) -> verify/verify_vo.py
             (--v <f.v> --vo <f.vo> [--rc N|--exit-file F] [--log L] [--json out] / --selftest)
  verify_gate6 gate6 census thin wrapper + EUM precedent mechanization -> verify/verify_gate6.py
             (--tree <dir>/--judge-before/--judge-after/--selftest; parameters and rc pass through 1:1 to the original)
  retrofit   gate7 English-surface adaptation (effort tooling; hardcoded work paths) -> verify/retrofit_gate7_irr.py
             (no argv interface — the unified entry only passes through 1:1, never runs its writes)

Routing notes:
  - Arguments and exit codes after the sub-verb pass through 1:1 (direct exec; fail-loud, never rewritten).
  - No sub-verb = the four generic entries are not unique -> exit 4 with a listing for manual disambiguation (same contract shape as certify/).
  - Unknown sub-verb -> exit 2 (legal sub-verbs listed).

Exit codes: 0=pass  1/2=each sub-tool's own convention, passed through (gate4 violation=1 · recheck=2)  2=unknown-sub-verb  4=ambiguous-entry  9=file-missing
EOF
}

case "${1:-}" in
  scan)
    [ -f "$SCAN_PY" ] || { echo "rocqwash scan: missing $SCAN_PY" >&2; exit 9; }
    shift; exec python3 "$SCAN_PY" "$@" ;;
  names)
    [ -f "$NAMES_PY" ] || { echo "rocqwash names: missing $NAMES_PY" >&2; exit 9; }
    shift; exec python3 "$NAMES_PY" "$@" ;;
  wash)    shift; run_module wash    "$ROOT/wash"    "$@" ;;
  verify)
    # Explicit routing (gate4|verify_vo|verify_gate6|retrofit sub-verbs; 1:1 passthrough;
    # verify_gate6 was added after the initial three — the route-table gap left a legal generic
    # entry blocked by unknown-sub-verb exit 2, a contract drift);
    # no sub-verb = the four generic entries are not unique, so run_module still runs -> exit 4
    # with a listing for manual disambiguation (same contract shape as certify/).
    # Zero frozen-file changes: the four .py bodies were never modified by this CLI.
    shift
    GATE4_PY="$ROOT/verify/gate4_comment_guard.py"
    VERIFYVO_PY="$ROOT/verify/verify_vo.py"
    VERIFYG6_PY="$ROOT/verify/verify_gate6.py"
    RETROFIT_PY="$ROOT/verify/retrofit_gate7_irr.py"
    case "${1:-}" in
      gate4)
        [ -f "$GATE4_PY" ] || { echo "rocqwash verify gate4: missing $GATE4_PY" >&2; exit 9; }
        shift; exec python3 "$GATE4_PY" "$@" ;;
      verify_vo)
        [ -f "$VERIFYVO_PY" ] || { echo "rocqwash verify verify_vo: missing $VERIFYVO_PY" >&2; exit 9; }
        shift; exec python3 "$VERIFYVO_PY" "$@" ;;
      verify_gate6)
        [ -f "$VERIFYG6_PY" ] || { echo "rocqwash verify verify_gate6: missing $VERIFYG6_PY" >&2; exit 9; }
        shift; exec python3 "$VERIFYG6_PY" "$@" ;;
      retrofit)
        [ -f "$RETROFIT_PY" ] || { echo "rocqwash verify retrofit: missing $RETROFIT_PY" >&2; exit 9; }
        shift; exec python3 "$RETROFIT_PY" "$@" ;;
      help|-h|--help) verify_usage; exit 0 ;;
      "") run_module verify "$ROOT/verify" ;;
      *)
        echo "rocqwash verify: unknown sub-verb: $1（未知子动词·legal: gate4|verify_vo|verify_gate6|retrofit）" >&2
        verify_usage >&2
        exit 2 ;;
    esac ;;
  seam)    shift; run_module seam    "$ROOT/seam"    "$@" ;;
  certify)
    # Explicit routing (freeze|push_gate|frozen8 sub-verbs; 1:1 passthrough); no sub-verb = the
    # three generic entries are not unique, so run_module still runs -> exit 4 with a listing for
    # manual disambiguation (same contract shape as verify/, see CONTRIBUTING §4②).
    # The frozen8 sub-verb: after certify/frozen8.py landed, the route table lacked it — a legal
    # generic entry blocked by unknown-sub-verb exit 2, a contract drift (same shape as the
    # verify_gate6 addition).
    # Zero frozen-file changes: the .py bodies were never modified by this CLI.
    shift
    FREEZE_PY="$ROOT/certify/freeze_manifest.py"
    PUSHGATE_PY="$ROOT/certify/push_gate.py"
    FROZEN8_PY="$ROOT/certify/frozen8.py"
    case "${1:-}" in
      freeze)
        [ -f "$FREEZE_PY" ] || { echo "rocqwash certify freeze: missing $FREEZE_PY" >&2; exit 9; }
        shift; exec python3 "$FREEZE_PY" "$@" ;;
      push_gate)
        [ -f "$PUSHGATE_PY" ] || { echo "rocqwash certify push_gate: missing $PUSHGATE_PY" >&2; exit 9; }
        shift; exec python3 "$PUSHGATE_PY" "$@" ;;
      frozen8)
        [ -f "$FROZEN8_PY" ] || { echo "rocqwash certify frozen8: missing $FROZEN8_PY" >&2; exit 9; }
        shift; exec python3 "$FROZEN8_PY" "$@" ;;
      help|-h|--help) certify_usage; exit 0 ;;
      "") run_module certify "$ROOT/certify" ;;
      *)
        echo "rocqwash certify: unknown sub-verb: $1（未知子动词·legal: freeze|push_gate|frozen8）" >&2
        certify_usage >&2
        exit 2 ;;
    esac ;;
  watch)   shift; run_module watch   "$ROOT/watch"   "$@" ;;
  help|-h|--help) usage; exit 0 ;;
  "") usage; exit 0 ;;
  *)
    echo "rocqwash: unknown subcommand: $1（未知子命令）" >&2
    usage >&2
    exit 2 ;;
esac
