#!/usr/bin/env bash
# cli/rocqwash — rocqwash 统一 CLI 入口（bash）· Unified CLI entry (bash)
#
# 子命令 Subcommands: scan | names | wash | verify | seam | certify | watch
#
# 路由契约 Routing contract:
#   1. 通用逐件入口（模块目录下唯一一个不带前导下划线的 .py）→ 自动路由，参数与
#      退出码 1:1 透传（fail-loud，不改写）。
#   2. 前导下划线 .py（如 wash/_abl1_wash.py）＝战役/席位专用工装：路径硬编码、
#      不接逐件 argv——统一入口**不代跑**（防误触外部沙箱写），直接 python3 调用。
#   3. 模块无通用入口 → exit 3（NOT-IMPLEMENTED，fail-loud，不模拟任何行为）。
#   4. 多个通用入口 → exit 4（入口不唯一，列清单要求人工指认）。
#
# 退出码 Exit codes:
#   0 = 通过   2 = 断言失败/未知子命令（含 certify/verify 未知子动词）   3 = 无通用逐件入口   4 = 通用入口不唯一（certify/verify 无子动词亦走此口径）
#   9 = 文件缺失   其余 = 各子工具自身口径透传（如 scan --selftest 向量失败 exit 2）
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCAN_PY="$ROOT/scan/mac_stmt_scan.py"
NAMES_PY="$ROOT/names/mac_stmt_names.py"

usage() {
  cat <<'EOF'
rocqwash — Coq/Rocq Constructive Proof Unblocking Engine（统一 CLI 入口 / unified CLI entry）

用法 Usage: rocqwash <subcommand> [args...]

子命令 Subcommands:
  scan     语句面 Prop 裸形扫描器              -> scan/mac_stmt_scan.py
           (--file/--json/--manifest/--hits-csv/--baseline/--selftest)
  names    顶层语句名有序清单 + N=N 有序全等断言 -> names/mac_stmt_names.py
           (<file>/--compare/--expect/--kinds/--include-let/--json/--names-out)
  wash     规范洗引擎（canonical wash engine）        -> wash/wash_engine.py
  verify   绿判四件套（green-verdict four-pack）      -> verify/  显式分派 (verify gate4|verify_vo|retrofit ...)
  seam     代际缝探针（W13 four-mechanism）           -> seam/seam_probe.py
  certify  两层冻结＋推窗四判据＋UNION v2             -> certify/ 显式分派 (certify freeze|push_gate ...)
  watch    CI 监控＋钉 IP 推送＋ls-remote 确证        -> watch/watch.py (ci/push/confirm)
  help     本帮助

路由说明 Routing notes:
  - 模块目录下唯一非 "_" 前缀 .py = 通用逐件入口，自动路由（参数/退出码透传）。
  - certify 双通用件（freeze_manifest＋push_gate）与 verify 三通用件（gate4＋
    verify_vo＋retrofit）走显式子动词分派：`rocqwash certify freeze|push_gate [args...]`、
    `rocqwash verify gate4|verify_vo|retrofit [args...]` 1:1 透传；无子动词＝入口
    不唯一 → exit 4 列清单人工指认；未知子动词 → exit 2。
  - "_" 前缀 .py = 战役/席位专用工装（路径硬编码·无逐件接口），统一入口不代跑；
    需要时直接 `python3 wash/_abl1_wash.py` 等方式调用。
  - 无通用入口 → exit 3；多个通用入口 → exit 4（列清单人工指认）。

退出码 Exit codes: 0=pass  2=assertion-fail/unknown-subcommand  3=no-generic-entry  4=ambiguous-entry  9=file-missing
EOF
}

not_implemented() {  # $1=subcommand  $2=dir
  echo "rocqwash $1: NOT-IMPLEMENTED — $2/ 目录为空，模块尚未落地。" >&2
  echo "  该子命令为统一入口预留位；模块实现落进 $2/ 后自动启用。" >&2
  echo "  (subcommand reserved; auto-enabled once the module lands — nothing is simulated here)" >&2
  exit 3
}

run_module() {  # $1=subcommand  $2=dir  rest = 透传参数
  local sub="$1" dir="$2"; shift 2
  local entry="" n=0 c=0 f base
  # 通用入口＝不带前导下划线的 .py；_ 前缀＝战役/席位专用工装（不由统一入口代跑）
  for f in "$dir"/*.py; do
    [ -e "$f" ] || continue
    c=$((c+1))
    base="$(basename "$f")"
    case "$base" in _*) continue ;; esac
    n=$((n+1)); entry="$f"
  done
  if [ "$n" -eq 1 ]; then
    exec python3 "$entry" "$@"
  elif [ "$n" -eq 0 ]; then
    if [ "$c" -gt 0 ]; then
      echo "rocqwash $sub: $dir/ 仅有战役/席位专用工装（_ 前缀·$c 个·路径硬编码/无逐件接口），统一入口不代跑：" >&2
      ls -A "$dir" >&2
      echo "  通用逐件入口落地后自动启用。(generic per-file entry pending — campaign tools must be invoked directly)" >&2
      exit 3
    fi
    not_implemented "$sub" "$dir"
  else
    echo "rocqwash $sub: $dir/ 含 $n 个通用入口（入口不唯一），请直接指认（ambiguous entry）:" >&2
    for f in "$dir"/*.py; do
      [ -e "$f" ] || continue
      base="$(basename "$f")"
      case "$base" in
        _*) echo "  [campaign-tool·不自动路由] $base" >&2 ;;
        *)  echo "  [generic] $base" >&2 ;;
      esac
    done
    exit 4
  fi
}

certify_usage() {  # certify 显式分派子帮助（explicit-dispatch sub-help）
  cat <<'EOF'
rocqwash certify — 两层冻结＋推窗四判据＋UNION v2（显式分派 / explicit dispatch）

用法 Usage: rocqwash certify <sub-verb> [args...]

子动词 Sub-verbs:
  freeze     两层冻结清单机检（tier1 逐件 md5＋tier2 清单 md5）  -> certify/freeze_manifest.py
             (<dir> freeze|check --out/--tier2/--manifest/--json/--selftest)
  push_gate  推窗四判据＋UNION v2 多世界清单                      -> certify/push_gate.py
             (window|union-freeze|union-check ... / --selftest)

路由说明 Routing notes:
  - 子动词后参数与退出码 1:1 透传（fail-loud，不改写）。
  - 无子动词＝双通用件入口不唯一 → exit 4 列清单人工指认（与 verify/ 同款契约形）。
  - 未知子动词 → exit 2（列合法子动词）。

退出码 Exit codes: 0=pass  2=unknown-sub-verb  4=ambiguous-entry  其余=子工具自身口径透传
EOF
}

verify_usage() {  # verify 显式分派子帮助（explicit-dispatch sub-help·与 certify_usage 同款契约形）
  cat <<'EOF'
rocqwash verify — 绿判四件套（green-verdict four-pack·显式分派 / explicit dispatch）

用法 Usage: rocqwash verify <sub-verb> [args...]

子动词 Sub-verbs:
  gate4      头注五字段机检守卫 v2.1（注释卫生三域扫描）        -> verify/gate4_comment_guard.py
             (--file/--tree/--tree-recursive/--baseline/--json/--emit-ledger/--selftest 无·单件/树扫)
  verify_vo  通用逐件绿判四件套（exit/log/魔数/新鲜度）         -> verify/verify_vo.py
             (--v <f.v> --vo <f.vo> [--rc N|--exit-file F] [--log L] [--json out] / --selftest)
  retrofit   gate7 英化 retrofit（战役工装·硬编码席位路径）     -> verify/retrofit_gate7_irr.py
             (无 argv 接口——统一入口只 1:1 透传，不代跑战役写)

路由说明 Routing notes:
  - 子动词后参数与退出码 1:1 透传（exec 直转·fail-loud，不改写）。
  - 无子动词＝三通用件入口不唯一 → exit 4 列清单人工指认（与 certify/ 同款契约形）。
  - 未知子动词 → exit 2（列合法子动词）。

退出码 Exit codes: 0=pass  1/2=子工具自身口径透传（gate4 违规=1·复核=2）  2=unknown-sub-verb  4=ambiguous-entry  9=file-missing
EOF
}

case "${1:-}" in
  scan)
    [ -f "$SCAN_PY" ] || { echo "rocqwash scan: missing $SCAN_PY" >&2; exit 9; }
    shift; exec python3 "$SCAN_PY" "$@" ;;
  names)
    [ -f "$NAMES_PY" ] || { echo "rocqwash names: missing $NAMES_PY" >&2; exit 9; }
    shift; exec python3 "$NAMES_PY" "$@" ;;
  wash)    shift; run_module wash    "$ROOT/wash"    "$@" ;;
  verify)
    # 显式分派（gate4|verify_vo|retrofit 子动词·1:1 透传·2026-10-31 适配席 rqadapt）；
    # 无子动词＝三通用件入口不唯一，仍走 run_module → exit 4 列清单人工指认
    # （与 certify/ 同款契约形）。冻结件零改动：三个 .py 本体未经本 CLI 修改。
    shift
    GATE4_PY="$ROOT/verify/gate4_comment_guard.py"
    VERIFYVO_PY="$ROOT/verify/verify_vo.py"
    RETROFIT_PY="$ROOT/verify/retrofit_gate7_irr.py"
    case "${1:-}" in
      gate4)
        [ -f "$GATE4_PY" ] || { echo "rocqwash verify gate4: missing $GATE4_PY" >&2; exit 9; }
        shift; exec python3 "$GATE4_PY" "$@" ;;
      verify_vo)
        [ -f "$VERIFYVO_PY" ] || { echo "rocqwash verify verify_vo: missing $VERIFYVO_PY" >&2; exit 9; }
        shift; exec python3 "$VERIFYVO_PY" "$@" ;;
      retrofit)
        [ -f "$RETROFIT_PY" ] || { echo "rocqwash verify retrofit: missing $RETROFIT_PY" >&2; exit 9; }
        shift; exec python3 "$RETROFIT_PY" "$@" ;;
      help|-h|--help) verify_usage; exit 0 ;;
      "") run_module verify "$ROOT/verify" ;;
      *)
        echo "rocqwash verify: 未知子动词 unknown sub-verb: $1（合法子动词 legal: gate4|verify_vo|retrofit）" >&2
        verify_usage >&2
        exit 2 ;;
    esac ;;
  seam)    shift; run_module seam    "$ROOT/seam"    "$@" ;;
  certify)
    # 显式分派（freeze|push_gate 子动词·1:1 透传）；无子动词＝双通用件入口不唯一，
    # 仍走 run_module → exit 4 列清单人工指认（与 verify/ 同款契约形，见 CONTRIBUTING §4②）。
    shift
    FREEZE_PY="$ROOT/certify/freeze_manifest.py"
    PUSHGATE_PY="$ROOT/certify/push_gate.py"
    case "${1:-}" in
      freeze)
        [ -f "$FREEZE_PY" ] || { echo "rocqwash certify: missing $FREEZE_PY" >&2; exit 9; }
        shift; exec python3 "$FREEZE_PY" "$@" ;;
      push_gate)
        [ -f "$PUSHGATE_PY" ] || { echo "rocqwash certify: missing $PUSHGATE_PY" >&2; exit 9; }
        shift; exec python3 "$PUSHGATE_PY" "$@" ;;
      help|-h|--help) certify_usage; exit 0 ;;
      "") run_module certify "$ROOT/certify" ;;
      *)
        echo "rocqwash certify: 未知子动词 unknown sub-verb: $1（合法子动词 legal: freeze|push_gate）" >&2
        certify_usage >&2
        exit 2 ;;
    esac ;;
  watch)   shift; run_module watch   "$ROOT/watch"   "$@" ;;
  help|-h|--help) usage; exit 0 ;;
  "") usage; exit 0 ;;
  *)
    echo "rocqwash: 未知子命令 unknown subcommand: $1" >&2
    usage >&2
    exit 2 ;;
esac
